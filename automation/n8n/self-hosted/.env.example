# Copy this file to .env and replace every CHANGE_ME value.
# Never commit the real .env file.

N8N_IMAGE=docker.n8n.io/n8nio/n8n:latest
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Kolkata
N8N_EXECUTIONS_MAX_AGE_HOURS=168

N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Generate a strong random value (32+ bytes) and keep it stable.
# If this changes after credentials are saved, n8n may no longer be able to decrypt them.
N8N_ENCRYPTION_KEY=CHANGE_ME_USE_A_LONG_RANDOM_ENCRYPTION_KEY
