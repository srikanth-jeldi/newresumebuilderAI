# Copy this file to .env and replace every CHANGE_ME value.
# Never commit the real .env file.

# n8n
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.35.3
N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false
GENERIC_TIMEZONE=Asia/Kolkata
N8N_EXECUTIONS_MAX_AGE_HOURS=168

# n8n database
N8N_DB_NAME=n8n
N8N_DB_USER=n8n
N8N_DB_PASSWORD=CHANGE_ME_USE_A_LONG_RANDOM_PASSWORD

# Stable n8n credential-encryption key. Do not rotate casually.
N8N_ENCRYPTION_KEY=CHANGE_ME_USE_A_LONG_RANDOM_ENCRYPTION_KEY

# n8n Sandbox service secrets.
# Use 32+ random bytes for each. Keep all three different.
SANDBOX_API_KEYS=CHANGE_ME_SANDBOX_EXTERNAL_API_KEY
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=CHANGE_ME_SANDBOX_REGISTRATION_TOKEN
SANDBOX_API_RUNNER_API_KEY=CHANGE_ME_SANDBOX_RUNNER_API_KEY

# Must match one value in SANDBOX_API_KEYS exactly.
N8N_SANDBOX_SERVICE_API_KEY=CHANGE_ME_SANDBOX_EXTERNAL_API_KEY
